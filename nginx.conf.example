# Contoh saja: ganti domain dan root sesuai server Anda.
server {
    listen 80;
    listen [::]:80;
    server_name jembatan.example.com;
    root /var/www/raksawaluya;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Jangan sajikan panduan/deploy script melalui web.
    location ~ ^/(deploy/|README\.md$|CREDITS\.md$|jalankan-.*\.(sh|bat)$) {
        deny all;
    }

    location ~* \.(webp|woff2|svg)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
